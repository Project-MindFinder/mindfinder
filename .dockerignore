# 버전관리/에디터
.git
.gitignore
.vscode
.idea

# 환경변수/비밀값 (이미지에 절대 포함 금지)
.env
*.env
!.env.example

# 데이터/로그/백업
data/
logs/
backups/
*.db
*.sqlite*

# 파이썬 캐시/가상환경
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# 테스트 (런타임 불필요)
tests/
# 문서: 약관/개인정보 전문은 런타임에 게시하므로 이미지에 포함한다.
*.md
!README.md
!docs/PRIVACY.md
!docs/TERMS.md
