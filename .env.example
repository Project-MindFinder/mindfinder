# ============================================
# MindFinder 봇 환경변수 예시 파일
# 실제 사용 시 이 파일을 복사하여 .env 로 만들고 값을 채우세요.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
# .env 파일은 절대 커밋하지 마세요. (.gitignore 에 포함됨)
# ============================================

# --- 필수 ---
# 디스코드 봇 토큰 (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=여기에_봇_토큰을_입력하세요

# --- 선택 (미입력 시 기본값 사용) ---

# 봇이 동작할 길드(서버) ID. 비워두면 모든 길드에서 슬래시 커맨드를 동기화합니다.
# 개발 중에는 테스트 서버 ID를 넣으면 커맨드가 즉시 반영됩니다.
GUILD_ID=

# 관리자(심사자) 역할 ID. 서류 심사 권한을 부여할 역할.
ADMIN_ROLE_ID=

# 인증 배지 역할 ID. 서류 심사 승인 시 부여할 역할.
VERIFIED_ROLE_ID=

# 증빙 서류를 업로드받을 비공개 채널 ID.
VERIFICATION_CHANNEL_ID=

# 위기 대응 안내를 남길 채널 ID (선택).
CRISIS_CHANNEL_ID=

# --- 데이터/로그 경로 (Docker 볼륨과 연동) ---
DATABASE_PATH=data/mindfinder.db
LOG_DIR=logs

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
