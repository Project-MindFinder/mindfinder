# ============================================
# MindFinder 봇 환경변수 예시 파일
# 실제 사용 시 이 파일을 복사하여 .env 로 만들고 값을 채우세요.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
# .env 파일은 절대 커밋하지 마세요. (.gitignore 에 포함됨)
# ============================================

# --- 필수 ---
# 디스코드 봇 토큰 (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=여기에_봇_토큰을_입력하세요

# --- 선택 (미입력 시 기본값 사용) ---

# 봇이 동작할 길드(서버) ID. 비워두면 모든 길드에서 슬래시 커맨드를 동기화합니다.
# 개발 중에는 테스트 서버 ID를 넣으면 커맨드가 즉시 반영됩니다.
GUILD_ID=

# 관리자(심사자) 역할 ID. 서류 심사 권한을 부여할 역할.
ADMIN_ROLE_ID=

# 인증 배지 역할 ID. 서류 심사 승인 시 부여할 역할.
VERIFIED_ROLE_ID=

# 증빙 서류를 업로드받을 비공개 채널 ID.
VERIFICATION_CHANNEL_ID=

# --- 접근 제어용 역할 ID (선택) ---
# 비워두면 봇이 서버에 역할을 자동 생성해 관리합니다.
# 1단계(인증됨): 자기 신고 이력 등록자. 전체 커뮤니티 열람.
VERIFIED_COMMUNITY_ROLE_ID=
# 2단계(서류 인증): 서류/진위확인 통과자. 병원·기간·매칭 채널 이용.
DOC_VERIFIED_ROLE_ID=

# 위기 대응 안내를 남길 채널 ID (선택).
CRISIS_CHANNEL_ID=

# 매칭 성사 시 봇이 생성할 비공개 채널을 둘 카테고리 ID (선택).
# 비워두면 서버 최상위에 채널이 생성됩니다.
MATCH_CATEGORY_ID=

# --- 채널 자동 구성 (선택) ---
# 병원별 커뮤니티 채널/역할을 묶을 카테고리 ID. 비워두면 봇이 자동 생성합니다.
HOSPITAL_CATEGORY_ID=
# 용도별 채널/카테고리가 없으면 자동 생성할지 여부 (기본 true).
AUTO_CREATE_CHANNELS=true
# 병원별로 별도 채널(및 역할)을 만들지 여부 (기본 true).
PER_HOSPITAL_CHANNELS=true
# 서류 인증이 없는 사용자도 매칭(동료 찾기)을 쓸 수 있게 할지 (기본 false).
ALLOW_UNVERIFIED_MATCHING=false

# --- 약관/개인정보 동의 (선택) ---
# 인증 시 필수 동의를 받는 문서의 버전. 값을 바꾸면 이용자에게 다시 동의를 받습니다.
PRIVACY_POLICY_VERSION=2026-10-06
TERMS_OF_SERVICE_VERSION=2026-10-06
# 문서 공개 URL (선택). 비워두면 서버 공지/`/약관` 명령으로 안내합니다.
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=

# 상시 패널(버튼 안내판)을 게시할 채널 ID (선택).
# 비워두면 봇이 "mindfinder-패널" 이름으로 찾고, 없으면 자동 생성합니다.
PANEL_CHANNEL_ID=
# 패널 채널이 없을 때 봇이 자동으로 만들지 여부 (기본 true).
# false 로 두면 PANEL_CHANNEL_ID 또는 기존 "mindfinder-패널" 채널만 사용합니다.
AUTO_CREATE_PANEL_CHANNEL=true

# --- 디스코드 특권 인텐트 (선택) ---
# 아래 두 인텐트는 디스코드 개발자 포털 > Bot > Privileged Gateway Intents 에서
# 반드시 먼저 활성화해야 합니다. 활성화하지 않은 상태에서 true 로 두면
# 봇이 "PrivilegedIntentsRequired" 오류로 로그인하지 못합니다.
# 개발자 포털에서 켤 수 없다면 false 로 설정하세요.
# - ENABLE_MEMBERS_INTENT: 역할 부여/조회(인증 배지)에 필요 (기본 true)
# - ENABLE_MESSAGE_CONTENT_INTENT: 위기 대응 키워드 감지에 필요 (기본 true)
ENABLE_MEMBERS_INTENT=true
ENABLE_MESSAGE_CONTENT_INTENT=true

# --- 서울대병원 문서 자동 진위확인 (선택) ---
# /진위확인 명령으로 입퇴원 사실확인서 PDF 를 자동 검증할지 여부 (기본 true).
SNUH_TRUTH_ENABLED=true
# 진위확인 사이트 주소 (보통 변경할 필요 없음).
SNUH_TRUTH_BASE_URL=https://sdoc.snuh.org
# 진위확인 요청 타임아웃(초).
SNUH_TRUTH_TIMEOUT=20

# --- 데이터/로그 경로 (Docker 볼륨과 연동) ---
DATABASE_PATH=data/mindfinder.db
LOG_DIR=logs

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
